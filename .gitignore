.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
!results/.gitkeep
# terraform
infra/terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/terraform/backend.hcl
infra/terraform/*.auto.tfvars
crash.log
.env
.DS_Store
infra/terraform/backend_override.tf
infra/terraform/local-state/

# Phase 5 generated reports (summary.csv/md, figures, manifest)
!reports/.gitkeep

# Suite S original-data archive: tarball stays local; checksums/file lists are tracked
archive/*/*.tar.gz

# Protocol v5 (2026-11-23): raw run output is never committed (RAW_DATA_AUDIT.md §2; v4 data already tracked stays
# tracked). Untracked run output would otherwise make `git status --porcelain` dirty mid-stage and fail the provenance
# gate. Sanitized exports + SHA-256 manifests are committed instead (scripts/export_v5_raw.py).
results/v5_*/
reports/v5/smoke/
reports/v5/stage_a/
reports/v5/stage_b/
reports/v5/export/
infra/state-bootstrap/.terraform/
infra/state-bootstrap/*.tfstate*
# X1 live raw output (exports are sanitized + hashed separately)
reports/x1/g0m0/
reports/x1/g0m1/
reports/x1/g1m0/
reports/x1/g1m1/
results/x1_*/
# X2 raw per-platform reports (stage logs, cell reports, qualification segments) and inputs tarballs
reports/x2/g0m0/
reports/x2/g0m1/
reports/x2/g1m0/
reports/x2/g1m1/
.x2_inputs/
results/x2_*/

# state bootstrap: local suffix + plan files (never committed)
infra/state-bootstrap/.bucket_suffix
infra/state-bootstrap/*.tfplan
infra/terraform/*.tfplan
infra/terraform/backend.hcl
.local-archive/

# local mirror of the AWS results bucket (raw evidence; never committed)
results/aws/
