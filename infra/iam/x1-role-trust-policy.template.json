{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeOnlyByTheX1OwnerUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::<ACCOUNT_ID>:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_ID>:user/<OWNER_IAM_USER>"
        }
      }
    }
  ]
}
