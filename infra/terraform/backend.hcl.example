# Copy to backend.hcl (gitignored). The state bucket must be created out-of-band
# (versioned, encrypted, public access blocked). Never commit state files.
bucket       = "REPLACE-with-your-tf-state-bucket"
key          = "mlsys-gpu-scheduling/research/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
